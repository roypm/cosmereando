{
  "name": "cosmereando",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint": "pnpm lint:css",
    "format": "prettier --write \"src/**/*.{astro,ts,json,css}\" package.json astro.config.mjs tsconfig.json .prettierrc.json .stylelintrc.json",
    "format:check": "prettier --check \"src/**/*.{astro,ts,json,css}\" package.json astro.config.mjs tsconfig.json .prettierrc.json .stylelintrc.json",
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "check": "pnpm lint:css && pnpm format:check && pnpm typecheck && pnpm test && ASTRO_TELEMETRY_DISABLED=1 astro build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
