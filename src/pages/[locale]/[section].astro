---
import PlaceholderPage from '../../components/PlaceholderPage.astro';
import BooksPage from '../../components/BooksPage.astro';
import RoutesPage from '../../components/RoutesPage.astro';
import { getSections } from '../../data/catalogue';
import { getTranslation, locales } from '../../data/i18n';
import {
  localizedSectionNames,
  type LocalizedSection,
} from '../../data/siteRoutes';
import type { Locale } from '../../data/locales';


export function getStaticPaths() {
  return locales.filter((locale) => locale !== 'en').flatMap((locale) =>
    localizedSectionNames.map((section) => ({ params: { locale, section } })),
  );
}

const locale = Astro.params.locale as Exclude<Locale, 'en'>;
const section = Astro.params.section as LocalizedSection;
const title = getTranslation(locale, `pages.${section}.title`);
const description = getTranslation(locale, `pages.${section}.description`);
const source = section === 'books' ? 'works' : section;
const sections = section === 'credits' ? [] : getSections(source as 'routes' | 'works' | 'sagas' | 'planets', locale);
---

{section === 'books' ? (
  <BooksPage locale={locale} />
) : section === 'routes' ? (
  <RoutesPage locale={locale} />
) : (
  <PlaceholderPage locale={locale} title={title} description={description} sections={sections} />
)}
