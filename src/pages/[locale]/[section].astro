---
import PlaceholderPage from "../../components/PlaceholderPage.astro";
import BooksPage from "../../components/BooksPage.astro";
import RoutesPage from "../../components/RoutesPage.astro";
import SagasPage from "../../components/SagasPage.astro";
import IndependentsPage from "../../components/IndependentsPage.astro";
import PlanetsPage from "../../components/PlanetsPage.astro";
import MagicSystemsPage from "../../components/MagicSystemsPage.astro";
import CreditsPage from "../../components/CreditsPage.astro";
import { getSections } from "../../data/catalogue";
import { getTranslation, locales } from "../../data/i18n";
import {
  localizedSectionNames,
  type LocalizedSection,
} from "../../data/siteRoutes";
import type { Locale } from "../../data/locales";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== "en")
    .flatMap((locale) =>
      localizedSectionNames.map((section) => ({ params: { locale, section } })),
    );
}

const locale = Astro.params.locale as Exclude<Locale, "en">;
const section = Astro.params.section as LocalizedSection;
const title = getTranslation(locale, `pages.${section}.title`);
const description = getTranslation(locale, `pages.${section}.description`);
const source =
  section === "books" || section === "independents"
    ? "works"
    : section === "magic-systems"
      ? "magicSystems"
      : section;
const sections =
  section === "credits"
    ? []
    : getSections(
        source as
          | "routes"
          | "works"
          | "sagas"
          | "planets"
          | "magicSystems"
          | "independents",
        locale,
      );
---

{
  section === "books" ? (
    <BooksPage locale={locale} />
  ) : section === "routes" ? (
    <RoutesPage locale={locale} />
  ) : section === "sagas" ? (
    <SagasPage locale={locale} />
  ) : section === "independents" ? (
    <IndependentsPage locale={locale} />
  ) : section === "planets" ? (
    <PlanetsPage locale={locale} />
  ) : section === "magic-systems" ? (
    <MagicSystemsPage locale={locale} />
  ) : section === "credits" ? (
    <CreditsPage locale={locale} />
  ) : (
    <PlaceholderPage
      locale={locale}
      title={title}
      description={description}
      sections={sections}
      parent={{ label: getTranslation(locale, "common.home"), href: "/" }}
    />
  )
}
