---
import SagaDetailPage from '../../components/SagaDetailPage.astro';
import MistbornSagaPage from '../../components/MistbornSagaPage.astro';
import WhiteSandSagaPage from '../../components/WhiteSandSagaPage.astro';
import StormlightSagaPage from '../../components/StormlightSagaPage.astro';
import ArcanumUnboundedPage from '../../components/ArcanumUnboundedPage.astro';
import { getSections } from '../../data/catalogue';

export function getStaticPaths() {
  return getSections('sagas', 'en').map((saga) => ({ params: { saga: saga.id } }));
}

const sagaId = Astro.params.saga as string;
---

{sagaId === 'mistborn' ? <MistbornSagaPage locale="en" /> : sagaId === 'white-sand' ? <WhiteSandSagaPage locale="en" /> : sagaId === 'the-stormlight-archive' ? <StormlightSagaPage locale="en" /> : sagaId === 'arcanum-unbounded' ? <ArcanumUnboundedPage locale="en" /> : <SagaDetailPage locale="en" sagaId={sagaId} />}
