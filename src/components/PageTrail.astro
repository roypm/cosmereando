---
import { getLocalizedPath, getTranslation } from '../data/i18n';
import type { Locale } from '../data/locales';

interface TrailItem {
  label: string;
  href?: string;
}

interface Props {
  locale: Locale;
  items: TrailItem[];
}

const { locale, items } = Astro.props;
const t = (key: string) => getTranslation(locale, key);
---

<nav class="page-trail" aria-label={t('common.breadcrumbs')}>
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href && index < items.length - 1 ? <a href={getLocalizedPath(locale, item.href)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </li>
    ))}
  </ol>
</nav>
