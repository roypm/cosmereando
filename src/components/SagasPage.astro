---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalNavbar from './GlobalNavbar.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';
import Sidebar from './Sidebar.astro';
import TableOfContents from './TableOfContents.astro';
import { getSections } from '../data/catalogue';
import { getLocalizedPath, getTranslation } from '../data/i18n';
import type { Locale } from '../data/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: string) => getTranslation(locale, key);
const path = (value: string) => getLocalizedPath(locale, value);
const sagas = getSections('sagas', locale);
---

<BaseLayout title={`Cosmereando — ${t('pages.sagas.title')}`} description={t('pages.sagas.description')} locale={locale}>
  <div class="documentation-shell">
    <Sidebar locale={locale} />
    <div class="page-layout">
      <GlobalNavbar locale={locale} />
      <main class="main-content sagas-page">
        <section class="sagas-page__masthead" id="introduction" aria-labelledby="sagas-heading">
          <div class="sagas-page__masthead-copy">
            <p class="eyebrow">{t('sagaPage.intro.eyebrow')}</p>
            <h1 id="sagas-heading">{t('sagaPage.intro.heading')}</h1>
            <p>{t('sagaPage.intro.description')}</p>
          </div>
          <div class="sagas-page__masthead-index" aria-label={t('sagaPage.intro.indexLabel')}>
            <span>{String(sagas.length).padStart(2, '0')}</span>
            <small>{t('sagaPage.intro.indexText')}</small>
          </div>
        </section>

        <section class="sagas-page__orientation" id="orientation" aria-labelledby="orientation-heading">
          <div class="sagas-page__orientation-mark" aria-hidden="true">✦</div>
          <div>
            <p class="section-kicker">{t('sagaPage.orientation.kicker')}</p>
            <h2 id="orientation-heading">{t('sagaPage.orientation.heading')}</h2>
            <p>{t('sagaPage.orientation.description')}</p>
          </div>
          <ImagePlaceholder label={t('sagaPage.orientation.imageLabel')} dimensions={t('sagaPage.orientation.imageDimensions')} imageText={t('common.imageHere')} variant="feature" />
        </section>

        <section class="sagas-page__directory" id="directory" aria-labelledby="directory-heading">
          <div class="sagas-page__directory-heading">
            <div>
              <p class="section-kicker">{t('sagaPage.directory.kicker')}</p>
              <h2 id="directory-heading">{t('sagaPage.directory.heading')}</h2>
            </div>
            <p>{t('sagaPage.directory.description')}</p>
          </div>
          <div class="saga-directory">
            {sagas.map((saga, index) => (
              <a class="saga-directory__item" href={path(`/sagas/${saga.id}`)}>
                <span class="saga-directory__number">{String(index + 1).padStart(2, '0')}</span>
                <span class="saga-directory__body">
                  <span class="saga-directory__label">{saga.label}</span>
                  <span class="saga-directory__description">{t(`sagaPage.directory.cards.${saga.id}`)}</span>
                </span>
                <span class="saga-directory__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </section>
      </main>
      <TableOfContents title={t('sagaPage.tableOfContents')} items={[
        { id: 'introduction', label: t('sagaPage.toc.introduction') },
        { id: 'orientation', label: t('sagaPage.toc.orientation') },
        { id: 'directory', label: t('sagaPage.toc.directory') },
      ]} />
    </div>
  </div>
</BaseLayout>
