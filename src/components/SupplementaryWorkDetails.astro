---
interface Props {
  id: string;
  title: string;
  action: string;
  closeLabel: string;
  typeLabel?: string;
  type?: string;
  showType?: boolean;
  originLabel: string;
  origin: string;
  whyLabel: string;
  why: string;
  whenLabel: string;
  when: string;
}

import ContextPopover from "./ContextPopover.astro";

const {
  id,
  title,
  action,
  closeLabel,
  typeLabel,
  type,
  showType = true,
  originLabel,
  origin,
  whyLabel,
  why,
  whenLabel,
  when,
} = Astro.props;
---

<ContextPopover
  id={id}
  title={title}
  triggerLabel={action}
  closeLabel={closeLabel}
  rows={[
    ...(showType && typeLabel && type
      ? [{ label: typeLabel, value: type }]
      : []),
    { label: originLabel, value: origin },
    { label: whyLabel, value: why },
    { label: whenLabel, value: when },
  ]}
/>
