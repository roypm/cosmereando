---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalNavbar from './GlobalNavbar.astro';
import EditorialImage from './EditorialImage.astro';
import Sidebar from './Sidebar.astro';
import TableOfContents from './TableOfContents.astro';
import PageTrail from './PageTrail.astro';
import PageReturn from './PageReturn.astro';
import { getSections } from '../data/catalogue';
import { getTranslation } from '../data/i18n';
import type { Locale } from '../data/locales';
import constellationMap from '../assets/images/general/cosmere_worlds_map.webp';
import communityRoute from '../assets/images/general/cosmere_character_artwork.webp';
import journeyRoute from '../assets/images/general/cosmere_dual_character_artwork.webp';

interface Props {
  locale: Locale;
  routeId: string;
}

const { locale, routeId } = Astro.props;
const route = getSections('routes', locale).find((section) => section.id === routeId);

if (!route) {
  throw new Error(`Unknown reading route: ${routeId}`);
}

const t = (key: string, replacements: Record<string, string> = {}) => getTranslation(locale, key, replacements);
const detailType = routeId === 'community-routes' ? 'community' : routeId === 'publication-order' ? 'publication' : 'myJourney';
const detailKey = `routePage.details.${detailType}`;
const routeImage = detailType === 'community' ? communityRoute : detailType === 'myJourney' ? journeyRoute : constellationMap;
---

<BaseLayout title={`Cosmereando — ${route.label}`} description={t(`${detailKey}.intro`, { route: route.label })} locale={locale}>
  <div class="documentation-shell">
    <Sidebar locale={locale} />
    <div class="page-layout">
      <GlobalNavbar locale={locale} />
      <PageTrail locale={locale} items={[{ label: t('common.home'), href: '/' }, { label: t('navigation.routes.title'), href: '/routes' }, { label: route.label }]} />
      <main class="main-content">
        <section class="page-intro hero route-detail__hero" id="introduction" aria-labelledby="route-heading">
          <div class="hero__layout">
            <div class="hero__content">
              <p class="eyebrow">{t(`${detailKey}.eyebrow`)}</p>
              <h1 id="route-heading">{route.label}</h1>
              <p class="hero__intro">{t(`${detailKey}.intro`, { route: route.label })}</p>
            </div>
            <EditorialImage src={routeImage} alt={t(`${detailKey}.imageLabel`, { route: route.label })} variant="hero" />
          </div>
        </section>

        {detailType === 'community' && (
          <>
            <section class="content-section" id="overview" aria-labelledby="overview-heading">
              <p class="section-kicker">{t(`${detailKey}.overview.kicker`)}</p>
              <h2 id="overview-heading">{t(`${detailKey}.overview.heading`)}</h2>
              <p>{t(`${detailKey}.overview.text`)}</p>
              <div class="info-grid">
                <article class="info-card"><span class="info-card__number">01</span><h3>{t(`${detailKey}.cards.focus.title`)}</h3><p>{t(`${detailKey}.cards.focus.text`)}</p></article>
                <article class="info-card"><span class="info-card__number">02</span><h3>{t(`${detailKey}.cards.flexibility.title`)}</h3><p>{t(`${detailKey}.cards.flexibility.text`)}</p></article>
                <article class="info-card"><span class="info-card__number">03</span><h3>{t(`${detailKey}.cards.balance.title`)}</h3><p>{t(`${detailKey}.cards.balance.text`)}</p></article>
              </div>
            </section>
            <section class="content-section content-section--quiet" id="next" aria-labelledby="next-heading">
              <p class="section-kicker">{t(`${detailKey}.next.kicker`)}</p>
              <h2 id="next-heading">{t(`${detailKey}.next.heading`)}</h2>
              <p>{t(`${detailKey}.next.text`)}</p>
            </section>
          </>
        )}

        {detailType === 'publication' && (
          <>
            <section class="content-section" id="overview" aria-labelledby="overview-heading">
              <p class="section-kicker">{t(`${detailKey}.overview.kicker`)}</p>
              <h2 id="overview-heading">{t(`${detailKey}.overview.heading`)}</h2>
              <p>{t(`${detailKey}.overview.text`)}</p>
              <ol class="route-detail__sequence">
                <li><span class="route-detail__sequence-number">01</span><div><h3>{t(`${detailKey}.sequence.first.title`)}</h3><p>{t(`${detailKey}.sequence.first.text`)}</p></div></li>
                <li><span class="route-detail__sequence-number">02</span><div><h3>{t(`${detailKey}.sequence.second.title`)}</h3><p>{t(`${detailKey}.sequence.second.text`)}</p></div></li>
                <li><span class="route-detail__sequence-number">03</span><div><h3>{t(`${detailKey}.sequence.third.title`)}</h3><p>{t(`${detailKey}.sequence.third.text`)}</p></div></li>
              </ol>
            </section>
            <section class="content-section content-section--quiet" id="next" aria-labelledby="next-heading">
              <p class="section-kicker">{t(`${detailKey}.next.kicker`)}</p>
              <h2 id="next-heading">{t(`${detailKey}.next.heading`)}</h2>
              <p>{t(`${detailKey}.next.text`)}</p>
            </section>
          </>
        )}

        {detailType === 'myJourney' && (
          <>
            <section class="content-section" id="overview" aria-labelledby="overview-heading">
              <p class="section-kicker">{t(`${detailKey}.overview.kicker`)}</p>
              <h2 id="overview-heading">{t(`${detailKey}.overview.heading`)}</h2>
              <div class="route-detail__note">
                <span class="route-detail__note-label">{t(`${detailKey}.note.label`)}</span>
                <p>{t(`${detailKey}.note.text`)}</p>
              </div>
            </section>
            <section class="content-section content-section--quiet" id="next" aria-labelledby="next-heading">
              <p class="section-kicker">{t(`${detailKey}.next.kicker`)}</p>
              <h2 id="next-heading">{t(`${detailKey}.next.heading`)}</h2>
              <p>{t(`${detailKey}.next.text`)}</p>
              <div class="info-grid">
                <article class="info-card"><span class="info-card__number">01</span><h3>{t(`${detailKey}.cards.origin.title`)}</h3><p>{t(`${detailKey}.cards.origin.text`)}</p></article>
                <article class="info-card"><span class="info-card__number">02</span><h3>{t(`${detailKey}.cards.changes.title`)}</h3><p>{t(`${detailKey}.cards.changes.text`)}</p></article>
                <article class="info-card"><span class="info-card__number">03</span><h3>{t(`${detailKey}.cards.criteria.title`)}</h3><p>{t(`${detailKey}.cards.criteria.text`)}</p></article>
              </div>
            </section>
          </>
        )}
        <PageReturn locale={locale} href="/routes" label={t('navigation.routes.title')} />
      </main>
      <TableOfContents title={t('routePage.tableOfContents')} items={[
        { id: 'introduction', label: t('routePage.toc.introduction') },
        { id: 'overview', label: t(`${detailKey}.toc.overview`) },
        { id: 'next', label: t(`${detailKey}.toc.next`) },
      ]} />
    </div>
  </div>
</BaseLayout>
