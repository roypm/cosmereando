---
import { getLocalizedPath, getTranslation } from '../data/i18n';
import type { Locale } from '../data/locales';

interface Props {
  locale: Locale;
  href: string;
  label: string;
}

const { locale, href, label } = Astro.props;
---

<div class="page-return-wrapper">
  <a class="page-return" href={getLocalizedPath(locale, href)}>{getTranslation(locale, 'common.returnTo', { label })} <span aria-hidden="true">↗</span></a>
</div>
