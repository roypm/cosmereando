---
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  variant?: 'hero' | 'feature' | 'portrait' | 'square' | 'book';
}

const { src, alt, variant = 'feature' } = Astro.props;
---

<img
  src={src.src}
  width={src.width}
  height={src.height}
  alt={alt}
  class:list={['editorial-image', `editorial-image--${variant}`]}
  loading="lazy"
  decoding="async"
 />
