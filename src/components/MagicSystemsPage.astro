---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlobalNavbar from './GlobalNavbar.astro';
import PageReturn from './PageReturn.astro';
import PageTrail from './PageTrail.astro';
import Sidebar from './Sidebar.astro';
import TableOfContents from './TableOfContents.astro';
import { getMagicSystems } from '../data/catalogue';
import { getLocalizedPath, getTranslation } from '../data/i18n';
import type { Locale } from '../data/locales';

interface Props { locale: Locale }

const { locale } = Astro.props;
const t = (key: string, replacements: Record<string, string> = {}) => getTranslation(locale, key, replacements);
const path = (value: string) => getLocalizedPath(locale, value);
const systems = getMagicSystems(locale);
---

<BaseLayout title={`Cosmereando — ${t('pages.magic-systems.title')}`} description={t('pages.magic-systems.description')} locale={locale}>
  <div class="documentation-shell">
    <Sidebar locale={locale} />
    <div class="page-layout">
      <GlobalNavbar locale={locale} />
      <PageTrail locale={locale} items={[{ label: t('common.home'), href: '/' }, { label: t('navigation.magicSystems.title') }]} />
      <main class="main-content magic-systems-page">
        <section class="page-intro magic-systems-page__masthead" id="introduction" aria-labelledby="magic-systems-heading">
          <div>
            <p class="eyebrow">{t('magicSystemsPage.intro.eyebrow')}</p>
            <h1 id="magic-systems-heading">{t('magicSystemsPage.intro.heading')}</h1>
            <p>{t('magicSystemsPage.intro.description')}</p>
          </div>
          <div class="magic-systems-page__count" aria-label={t('magicSystemsPage.intro.countLabel')}>
            <span>{String(systems.length).padStart(2, '0')}</span>
            <small>{t('magicSystemsPage.intro.countText')}</small>
          </div>
        </section>

        <section class="magic-systems-page__directory" id="directory" aria-labelledby="directory-heading">
          <div class="magic-systems-page__directory-heading">
            <div>
              <p class="section-kicker">{t('magicSystemsPage.directory.kicker')}</p>
              <h2 id="directory-heading">{t('magicSystemsPage.directory.heading')}</h2>
            </div>
            <p>{t('magicSystemsPage.directory.description')}</p>
          </div>
          <div class="magic-system-directory">
            {systems.map((system, index) => (
              <article class="magic-system-card" id={system.id}>
                <div class="magic-system-card__meta">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{system.world}</span>
                </div>
                <h3>{system.label}</h3>
                <p>{t(`magicSystemsPage.items.${system.id}.description`)}</p>
                <a href={path(`/planets/${system.worldId}`)}>{t('magicSystemsPage.directory.worldLink', { world: system.world })} <span aria-hidden="true">↗</span></a>
              </article>
            ))}
          </div>
        </section>

        <PageReturn locale={locale} href="/" label={t('common.home')} />
      </main>
      <TableOfContents title={t('magicSystemsPage.tableOfContents')} items={[
        { id: 'introduction', label: t('magicSystemsPage.toc.introduction') },
        { id: 'directory', label: t('magicSystemsPage.toc.directory') },
      ]} />
    </div>
  </div>
</BaseLayout>
